# Supabase connection string (Project Settings > Database > Connection string > URI)
# Use the direct connection (port 5432) for Alembic migrations, not the pgbouncer pooler.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Secret used to sign JWTs issued by this backend's own auth routes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Where uploaded PDFs are stored on disk in Phase 1 (moves to S3 in Phase 4)
UPLOAD_DIR=./uploads

# Embedding model dimension, used by the pgvector column. 384 fits all-MiniLM-L6-v2.
EMBEDDING_DIM=384
